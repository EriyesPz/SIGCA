generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Alerts {
  Id          String   @id
  CargoId     String
  Type        String
  Message     String?
  TriggeredAt DateTime @default(now())
  Resolved    Boolean  @default(false)
  TriggeredBy String?
  Cargo       Cargo    @relation(fields: [CargoId], references: [Id])
  Users       Users?   @relation("Alerts_TriggeredBy", fields: [TriggeredBy], references: [Id])
}

model Cargo {
  Id                        String                 @id @default(uuid())
  TrackingCode              String?
  Description               String?
  Status                    String
  WeightKg                  Float
  Quantity                  Int
  EntryDate                 DateTime               @default(now())
  ExitDate                  DateTime?
  IsPerishable              Boolean                @default(false)
  WarehouseId               String?
  RackId                    String?
  LevelId                   String?
  ColumnId                  String?
  CreatedBy                 String?
  AirWaybillNumber          String?
  ArrivalDate               DateTime?
  CargoType                 String?
  Consignee                 Json?
  ContainerNumber           String?
  CustomsDeclarationNumber  String?
  CustomsStatus             String?
  DamageDescription         String?
  DamageReported            Boolean                @default(false)
  DeclaredValueUSD          Float?
  DepartureDate             DateTime?
  DestinationAirport        String?
  DimensionsCm              Json?
  FlightDate                DateTime?
  FlightNumber              String?
  HandlingInstructions      String?
  HouseAirWaybillNumber     String?
  InsurancePolicyNumber     String?
  InternalReference         String?
  IsHazardousMaterial       Boolean                @default(false)
  IsHighValue               Boolean                @default(false)
  LastInspectionDate        DateTime?
  ManifestNumber            String?
  MasterAirWaybillNumber    String?
  OriginAirport             String?
  QRCode                    String?
  SealNumber                String?
  Shipper                   Json?
  TemperatureRequirement    String?
  ULDNumber                 String?
  VolumeM3                  Float?

  Alerts                    Alerts[]
  Users                     Users?                 @relation("Cargo_CreatedBy", fields: [CreatedBy], references: [Id])
  Warehouse                 Warehouse?             @relation(fields: [WarehouseId], references: [Id], onDelete: Cascade)
  CargoDocuments            CargoDocuments[]
  CargoLocationHistory      CargoLocationHistory[]
  CargoStatusHistory        CargoStatusHistory[]
  Deliveries                Deliveries[]
  Transfers                 Transfers[]
  RackColumn                RackColumns?           @relation(fields: [ColumnId], references: [Id], onDelete: Cascade)
}

model CargoDocuments {
  Id         String   @id @default(uuid())
  CargoId    String
  FileUrl    String
  Type       String
  Metadata   Json?
  CreatedAt  DateTime @default(now())
  CreatedBy  String?
  Cargo      Cargo    @relation(fields: [CargoId], references: [Id], onDelete: Cascade)
  Users      Users?   @relation("CargoDocuments_CreatedBy", fields: [CreatedBy], references: [Id])
}

model CargoLocationHistory {
  Id           String   @id @default(uuid())
  CargoId      String
  FromRackId   String?
  FromLevelId  String?
  FromColumnId String?
  ToRackId     String?
  ToLevelId    String?
  ToColumnId   String?
  MovedAt      DateTime @default(now())
  MovedBy      String?
  Cargo        Cargo    @relation(fields: [CargoId], references: [Id])
  Users        Users?   @relation("CargoLocationHistory_MovedBy", fields: [MovedBy], references: [Id])
}

model CargoStatusHistory {
  Id             String   @id @default(uuid())
  CargoId        String
  PreviousStatus String?
  NewStatus      String
  ChangedAt      DateTime @default(now())
  ChangedBy      String?
  Cargo          Cargo    @relation(fields: [CargoId], references: [Id])
  Users          Users?   @relation("CargoStatusHistory_ChangedBy", fields: [ChangedBy], references: [Id])
}

model Categories {
  Id        String   @id @default(uuid())
  Name      String
  Icon      String?
  Color     String?
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  CreatedBy String?
  Users     Users?   @relation("Categories_CreatedBy", fields: [CreatedBy], references: [Id])
}

model Deliveries {
  Id          String   @id @default(uuid())
  CargoId     String
  Receiver    String
  DeliveredAt DateTime
  VerifiedBy  String
  DeliveredBy String?
  Metadata    Json?
  Cargo       Cargo    @relation(fields: [CargoId], references: [Id])
  Users       Users?   @relation("Deliveries_DeliveredBy", fields: [DeliveredBy], references: [Id])
}

model Racks {
  Id          String       @id
  Name        String
  WarehouseId String
  Capacity    Int
  CreatedAt   DateTime     @default(now())
  CreatedBy   String?
  Code        String?      @db.VarChar(5)
  RackLevels  RackLevels[]
  Users       Users?       @relation("Racks_CreatedBy", fields: [CreatedBy], references: [Id])
  Warehouse   Warehouse    @relation(fields: [WarehouseId], references: [Id], onDelete: Cascade)
}

model Transfers {
  Id               String   @id @default(uuid())
  CargoId          String
  FromWarehouseId  String
  ToWarehouseId    String
  TransferDate     DateTime @default(now())
  Notes            String?
  TransferredBy    String?
  FromRackId       String?
  ToRackId         String?
  FromLevelId      String?
  ToLevelId        String?
  FromColumnId     String?
  ToColumnId       String?
  Cargo            Cargo     @relation(fields: [CargoId], references: [Id])
  Warehouse_Transfers_FromWarehouseIdToWarehouse Warehouse @relation("Transfers_FromWarehouseIdToWarehouse", fields: [FromWarehouseId], references: [Id])
  Warehouse_Transfers_ToWarehouseIdToWarehouse   Warehouse @relation("Transfers_ToWarehouseIdToWarehouse", fields: [ToWarehouseId], references: [Id])
  Users           Users?     @relation("Transfers_TransferredBy", fields: [TransferredBy], references: [Id])
}

model Warehouse {
  Id                                             String      @id @default(uuid())
  Name                                           String
  IsActive                                       Boolean     @default(true)
  CreatedAt                                      DateTime    @default(now())
  CreatedBy                                      String?
  Cargo                                          Cargo[]
  Racks                                          Racks[]
  Transfers_Transfers_FromWarehouseIdToWarehouse Transfers[] @relation("Transfers_FromWarehouseIdToWarehouse")
  Transfers_Transfers_ToWarehouseIdToWarehouse   Transfers[] @relation("Transfers_ToWarehouseIdToWarehouse")
  Users                                          Users?      @relation("Warehouse_CreatedBy", fields: [CreatedBy], references: [Id])
}

model Users {
  Id                   String                 @id @default(uuid())
  Email                String                 @unique
  FirstName            String?
  LastName             String?
  User                 String
  Password             String?
  IsActive             Boolean                @default(true)
  Avatar               String?
  CreatedAt            DateTime               @default(now())

  AlertsTriggered        Alerts[]               @relation("Alerts_TriggeredBy")
  CreatedCargos          Cargo[]                @relation("Cargo_CreatedBy")
  CreatedDocuments       CargoDocuments[]       @relation("CargoDocuments_CreatedBy")
  MovedCargoHistory      CargoLocationHistory[] @relation("CargoLocationHistory_MovedBy")
  ChangedCargoStatus     CargoStatusHistory[]   @relation("CargoStatusHistory_ChangedBy")
  CreatedCategories      Categories[]           @relation("Categories_CreatedBy")
  DeliveriesMade         Deliveries[]           @relation("Deliveries_DeliveredBy")
  CreatedRacks           Racks[]                @relation("Racks_CreatedBy")
  Sessions               Sessions[]
  TransfersMade          Transfers[]            @relation("Transfers_TransferredBy")
  UserRoles              UserRoles[]
  CreatedWarehouses      Warehouse[]            @relation("Warehouse_CreatedBy")
}

model Sessions {
  Id        String   @id @default(uuid())
  UserId    String
  Token     String
  UserAgent String?
  IpAddress String?
  CreatedAt DateTime @default(now())
  ExpiresAt DateTime
  Users     Users    @relation(fields: [UserId], references: [Id], onDelete: Cascade)
}

model UserRoles {
  UserId String
  RoleId String
  Roles  Roles  @relation(fields: [RoleId], references: [Id], onDelete: Cascade)
  Users  Users  @relation(fields: [UserId], references: [Id], onDelete: Cascade)

  @@id([UserId, RoleId])
}

model Roles {
  Id              String            @id
  Name            String            @unique
  RolePermissions RolePermissions[]
  UserRoles       UserRoles[]
}

model RolePermissions {
  RoleId       String
  PermissionId String
  Permissions  Permissions @relation(fields: [PermissionId], references: [Id], onDelete: Cascade)
  Roles        Roles       @relation(fields: [RoleId], references: [Id], onDelete: Cascade)

  @@id([RoleId, PermissionId])
}

model Permissions {
  Id              String            @id
  Name            String            @unique
  RolePermissions RolePermissions[]
}

model EmailOTPs {
  Id        String   @id @default(uuid())
  Email     String
  Otp       String
  ExpiresAt DateTime
  Used      Boolean  @default(false)
  CreatedAt DateTime @default(now())
}

model RackLevels {
  Id          String        @id
  RackId      String
  LevelNumber Int
  RackColumns RackColumns[]
  Racks       Racks         @relation(fields: [RackId], references: [Id], onDelete: Cascade)
}

model RackColumns {
  Id         String     @id
  LevelId    String
  ColumnCode String     @db.VarChar(3)
  RackLevels RackLevels @relation(fields: [LevelId], references: [Id], onDelete: Cascade)
  Cargos     Cargo[]
}
